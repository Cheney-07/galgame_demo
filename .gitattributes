# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Force UTF-8 encoding for all text files (prevent Chinese garbled text on Windows)
*.gd text eol=lf linguist-language=GDScript
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.dtl text eol=lf
*.dch text eol=lf
*.godot text eol=lf
*.md text eol=lf
*.json text eol=lf
*.import text eol=lf
*.uid text eol=lf
